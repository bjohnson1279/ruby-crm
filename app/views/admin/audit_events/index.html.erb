<style>
  /* Sleek Pagy styling override for dark mode */
  .pagy-nav { display: flex; gap: 0.35rem; font-family: monospace; font-size: 0.875rem; }
  .pagy-nav a, .pagy-nav span { padding: 0.35rem 0.85rem; border-radius: 0.375rem; border: 1px solid #334155; background-color: #1e293b; color: #cbd5e1; transition: all 0.15s ease; text-decoration: none; }
  .pagy-nav a:hover { border-color: #22d3ee; color: #ffffff; background-color: #0f172a; }
  .pagy-nav .current { background-color: #0891b2; color: #ffffff; border-color: #0891b2; font-weight: bold; }
  .pagy-nav .disabled { color: #475569; border-color: #1e293b; cursor: not-allowed; background-color: #0b0f19; }
</style>

<div class="space-y-6">
  <div class="flex justify-between items-center bg-slate-900 p-6 rounded-lg border border-slate-800 shadow-md">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-white">Compliance Audit Trail</h2>
      <p class="text-sm text-slate-400 mt-1">Immutable record of all modifications within the enterprise boundaries</p>
    </div>
    <div>
      <span class="text-xs text-slate-300 bg-slate-800 border border-slate-700 py-1.5 px-3 rounded-full font-mono font-semibold">
        <%= @pagy.count %> Total Events
      </span>
    </div>
  </div>

  <%= form_with url: admin_audit_events_path, method: :get, local: true, class: "bg-slate-900 p-4 rounded-lg border border-slate-800 flex flex-wrap gap-4 items-end" do |f| %>
    <div>
      <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Action Type</label>
      <%= f.select :action_filter, options_for_select([["All Actions", ""], ["Created", "created"], ["Updated", "updated"], ["Deleted", "deleted"]], params[:action_filter]), {}, class: "bg-slate-800 border border-slate-700 rounded px-3 py-1.5 text-sm text-white focus:outline-none focus:border-cyan-500" %>
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Entity Type</label>
      <%= f.select :type_filter, options_for_select([["All Entities", ""], ["Contact", "Contacts::Contact"], ["Household", "Contacts::Household"], ["Account", "Accounts::InvestmentAccount"], ["Holding", "Accounts::Holding"]], params[:type_filter]), {}, class: "bg-slate-800 border border-slate-700 rounded px-3 py-1.5 text-sm text-white focus:outline-none focus:border-cyan-500" %>
    </div>
    <div>
      <%= f.submit "Apply Filters", class: "bg-cyan-600 hover:bg-cyan-500 text-white font-bold py-1.5 px-5 rounded text-sm transition-colors cursor-pointer" %>
      <%= link_to "Reset", admin_audit_events_path, class: "ml-2 text-slate-400 hover:text-white text-sm" %>
    </div>
  <% end %>

  <div class="bg-slate-900 rounded-lg border border-slate-800 shadow-lg overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-800 text-sm text-left">
        <thead>
          <tr class="text-slate-400 uppercase text-xs font-bold tracking-wider bg-slate-850/50">
            <th class="py-3.5 px-6">Occurred At</th>
            <th class="py-3.5 px-6">Actor</th>
            <th class="py-3.5 px-6">Action</th>
            <th class="py-3.5 px-6">Auditable Entity</th>
            <th class="py-3.5 px-6">Payload Preview</th>
            <th class="py-3.5 px-6 text-right">Details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-850">
          <% if @audit_events.empty? %>
            <tr>
              <td colspan="6" class="py-6 text-center text-slate-500">No compliance audit events match your filters.</td>
            </tr>
          <% else %>
            <% @audit_events.each do |event| %>
              <tr class="hover:bg-slate-850/30">
                <td class="py-3.5 px-6 font-mono text-xs text-slate-400"><%= event.occurred_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
                <td class="py-3.5 px-6 font-medium text-slate-200"><%= event.actor&.name || 'System' %></td>
                <td class="py-3.5 px-6">
                  <span class="px-2 py-0.5 rounded text-xs font-mono font-bold uppercase <%= case event.action; when 'created'; 'bg-emerald-950/50 text-emerald-400 border border-emerald-500/20'; when 'deleted'; 'bg-red-950/50 text-red-400 border border-red-500/20'; else 'bg-blue-950/50 text-blue-400 border border-blue-500/20'; end %>">
                    <%= event.action %>
                  </span>
                </td>
                <td class="py-3.5 px-6 text-slate-300">
                  <span class="text-xs text-slate-500 block font-semibold"><%= event.auditable_type.to_s.demodulize %></span>
                  <span class="font-mono text-xs text-slate-400">ID: <%= event.auditable_id %></span>
                </td>
                <td class="py-3.5 px-6 text-slate-400 max-w-xs truncate font-mono text-xs"><%= event.payload.inspect %></td>
                <td class="py-3.5 px-6 text-right">
                  <%= link_to "View Detail", admin_audit_event_path(event), class: "text-cyan-400 hover:text-cyan-300 font-bold text-xs" %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="bg-slate-850/20 px-6 py-4 border-t border-slate-800 flex justify-center text-slate-400">
        <%== series_nav(@pagy) %>
      </div>
    <% end %>
  </div>
</div>
