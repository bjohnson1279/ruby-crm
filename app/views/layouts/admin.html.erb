<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Redtail CRM Admin Panel</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            slate: {
              850: '#1e293b',
              950: '#0b0f19'
            }
          }
        }
      }
    }
  </script>
  <style>
    /* CSS micro-animations & transitions */
    .fade-in { animation: fadeIn 0.4s ease-out; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">
  <header class="bg-slate-900 border-b border-slate-800 py-4 px-6 flex justify-between items-center shadow-lg">
    <div class="flex items-center space-x-3">
      <div class="h-8 w-8 rounded bg-gradient-to-tr from-cyan-400 to-indigo-600 flex items-center justify-center font-black text-white shadow-md">
        Ω
      </div>
      <h1 class="text-xl font-bold bg-gradient-to-r from-white to-slate-300 bg-clip-text text-transparent">
        Redtail Enterprise CRM Admin
      </h1>
    </div>
    <nav class="flex items-center space-x-6 text-sm">
      <a href="/admin" class="hover:text-cyan-400 transition-colors font-semibold py-1">Integrity Dashboard</a>
      <a href="/admin/audit_events" class="hover:text-cyan-400 transition-colors font-semibold py-1">Audit Trail</a>
      <span class="text-slate-700">|</span>
      <span class="text-xs text-slate-300 bg-slate-800 py-1 px-3 rounded-full border border-slate-700 font-mono shadow-sm">
        Tenant: <%= Current.firm&.name %>
      </span>
    </nav>
  </header>

  <main class="flex-grow p-6 md:p-8 max-w-7xl mx-auto w-full fade-in">
    <%= yield %>
  </main>

  <footer class="bg-slate-900 border-t border-slate-800 py-4 text-center text-xs text-slate-500 shadow-inner">
    &copy; 2026 Redtail Financial CRM Systems &bull; Strict Database Integrity &amp; Compliance Logs
  </footer>
</body>
</html>
